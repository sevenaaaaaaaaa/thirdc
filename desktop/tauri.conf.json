{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ThirdC Studio",
  "version": "0.1.2",
  "identifier": "com.nownexts.thirdc",
  "build": {
    "frontendDist": "../server/web"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "category": "Productivity",
    "shortDescription": "AI Native 知识工作台",
    "longDescription": "ThirdC Studio：你的知识库是文件，也是画布，也是 agent 的工具。本地优先、开源、无锁定。",
    "copyright": "AGPL-3.0-or-later"
  }
}
