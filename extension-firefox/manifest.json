{
  "manifest_version": 3,
  "name": "ThirdC Clipper",
  "version": "0.2.0",
  "description": "一键采集网页到 ThirdC 知识库",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage", "notifications"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_popup": "popup.html", "default_icon": { "48": "icon48.png" } },
  "background": { "scripts": ["bg.js"] },
  "browser_specific_settings": {
    "gecko": { "id": "thirdc@nownexts.com", "strict_min_version": "115.0" }
  },
  "icons": { "48": "icon48.png" }
}
